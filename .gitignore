# Файлы Python, созданные во время запуска.
__pycache__/
*.py[cod]
*.egg-info/

# Виртуальные окружения и настройки редакторов.
.venv/
venv/
.vscode/
.idea/
.pytest_cache/

# Сгенерированные экземпляры не добавляются в Git автоматически.
# При необходимости отдельные проверенные данные можно добавить вручную.
data/generated/*.json
!data/generated/.gitkeep
